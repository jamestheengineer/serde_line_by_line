#!/usr/bin/env bash
#
# Runs the same gates as .github/workflows/ci.yml before a push leaves the
# machine, so a red run on GitHub is caught here instead of there.
#
# Every CI failure this repo has had was `cargo fmt --all --check` on a file
# that was committed unformatted and then pushed seven more times before
# anyone noticed. fmt runs first below for that reason: it is the cheapest
# gate and the one that actually breaks.
#
# Keep the command list in step with ci.yml. If you add a step there, add it
# here; the two files reference each other so neither is edited alone.
#
# To push anyway (a WIP branch, a known-broken bisect point):
#     git push --no-verify

set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

bold=$'\033[1m'; red=$'\033[31m'; green=$'\033[32m'; yellow=$'\033[33m'; dim=$'\033[2m'; off=$'\033[0m'
[ -t 2 ] || { bold=""; red=""; green=""; yellow=""; dim=""; off=""; }

# A push that only deletes remote refs builds nothing.
only_deletes=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    case "$local_sha" in
        *[!0]*) only_deletes=0 ;;
    esac
done
[ "$only_deletes" -eq 1 ] && exit 0

# Stops at the first failing gate. One broken gate cascades into the rest —
# an unformatted file fails Format, then Clippy, then every build downstream —
# and five screens of fallout buries the one line that has to be fixed.
fail() {
    printf '\n%s\n' "${red}${bold}push blocked: ${1} would fail CI${off}" >&2
    printf '%s\n' "${dim}fix, or bypass with: git push --no-verify${off}" >&2
    exit 1
}

run_gate() {
    local name="$1"; shift
    printf '%s\n' "${dim}ci: ${name}...${off}" >&2
    local out
    if ! out=$("$@" 2>&1); then
        printf '\n%s\n' "${red}${bold}✗ ${name}${off}  ${dim}\$ $*${off}" >&2
        printf '%s\n' "$out" | tail -40 >&2
        fail "$name"
    fi
}

# --- check job -------------------------------------------------------------
run_gate "Format"     cargo fmt --all --check
run_gate "Clippy"     cargo clippy --workspace --all-targets -- -D warnings
run_gate "Examples"   cargo test --workspace
run_gate "Coverage"   cargo xtask coverage --json
run_gate "Build site" cargo site

# --- wasm job --------------------------------------------------------------
# Skipped, loudly, when the local toolchain cannot reproduce it. CI still runs
# these, so a skip here means the push is only partly verified.
wasm_pin=$(sed -n 's/^wasm-bindgen = "=\(.*\)"$/\1/p' playground/Cargo.toml)
wasm_skip=""
if ! rustup target list --installed 2>/dev/null | grep -qx wasm32-unknown-unknown; then
    wasm_skip="wasm32-unknown-unknown target not installed (rustup target add wasm32-unknown-unknown)"
elif ! command -v wasm-bindgen >/dev/null 2>&1; then
    wasm_skip="wasm-bindgen not on PATH (cargo install wasm-bindgen-cli@${wasm_pin})"
elif [ -n "$wasm_pin" ] && [ "$(wasm-bindgen --version 2>/dev/null | awk '{print $2}')" != "$wasm_pin" ]; then
    wasm_skip="wasm-bindgen $(wasm-bindgen --version 2>/dev/null | awk '{print $2}') does not match the ${wasm_pin} pin in playground/Cargo.toml"
fi

if [ -n "$wasm_skip" ]; then
    printf '%s\n' "${yellow}! skipping the wasm job: ${wasm_skip}${off}" >&2
else
    # shellcheck disable=SC2046
    run_gate "Build examples for wasm32" \
        cargo build --target wasm32-unknown-unknown $(printf -- '-p %s ' $(ls examples))
    run_gate "Build playground" cargo xtask wasm
    run_gate "Site with playground" cargo site
fi

if ! git diff --quiet || ! git diff --cached --quiet; then
    printf '%s\n' "${yellow}! gates passed, but the working tree is dirty — CI tests the commits, not these edits${off}" >&2
fi

printf '%s\n' "${green}ci gates passed${off}" >&2
exit 0
